set(build "@CMAKE_BINARY_DIR@")
string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
foreach(mode main confirmation failed-factory missing)
  set(stage "${build}/smoke-${stamp}-${mode}")
  file(COPY "${build}/dist/bin" DESTINATION "${stage}")
  set(root "${stage}/bin/l4p")
  file(MAKE_DIRECTORY "${root}/backend" "${root}/plugins/bad.abi" "${root}/plugins/bad.id")
  if(NOT mode STREQUAL "missing")
    file(COPY "${build}/fixtures/dxvk.dll" DESTINATION "${root}/backend")
  endif()
  file(COPY_FILE "${build}/fixtures/bad_abi.dll" "${root}/plugins/bad.abi/plugin.dll")
  file(COPY_FILE "${root}/plugins/demo.hello/plugin.dll" "${root}/plugins/bad.id/plugin.dll")
  file(READ "${root}/plugins/demo.hello/manifest.json" manifest)
  if(@CMAKE_SIZEOF_VOID_P@ EQUAL 8)
    string(REPLACE "\"x86\"" "\"x64\"" manifest "${manifest}")
  endif()
  if(mode STREQUAL "confirmation")
    string(REPLACE "\"effect\": \"read\"" "\"effect\": \"write\"" manifest "${manifest}")
    string(REPLACE "\"requiresConfirmation\": false" "\"requiresConfirmation\": true" manifest "${manifest}")
  endif()
  file(WRITE "${root}/plugins/demo.hello/manifest.json" "${manifest}")
  string(REPLACE "\"id\": \"demo.hello\"" "\"id\": \"bad.abi\"" bad "${manifest}")
  file(WRITE "${root}/plugins/bad.abi/manifest.json" "${bad}")
  string(REPLACE "\"id\": \"demo.hello\"" "\"id\": \"bad.id\"" bad "${manifest}")
  file(WRITE "${root}/plugins/bad.id/manifest.json" "${bad}")
  file(WRITE "${root}/enabled.txt" "demo.hello\nbad.abi\nbad.id\ndemo.hello\n")
  execute_process(COMMAND "${build}/fixtures/l4p_smoke.exe" "${stage}/bin/dxvk_d3d9.dll" "${mode}" RESULT_VARIABLE result TIMEOUT 10)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Offline ${mode} failed: ${result}; stage ${stage}")
  endif()
endforeach()
