# Small header-free C boundary; normal Source and consumers keep their toolchain.
function(l4p_native_seh target source)
  target_sources(${target} PRIVATE "${source}")
  if(MINGW)
    if(NOT CMAKE_C_COMPILER_ID MATCHES "Clang")
      message(FATAL_ERROR "Native x86 SEH bridge requires LLVM-MinGW or MSVC")
    endif()
    set_source_files_properties("${source}" PROPERTIES COMPILE_OPTIONS "--target=i686-pc-windows-msvc;-fms-extensions;-fno-stack-protector")
    # Import only the Windows x86 SEH dispatcher. Linking all of msvcrt-os would
    # redirect unrelated C++/UCRT symbols to the legacy CRT.
    if(NOT TARGET l4p_seh_dispatch)
      set(def "${CMAKE_BINARY_DIR}/native_seh_dispatch.def")
      set(lib "${CMAKE_BINARY_DIR}/native_seh_dispatch.a")
      file(WRITE "${def}" "LIBRARY msvcrt.dll\nEXPORTS\n  _except_handler3\n")
      execute_process(COMMAND "${CMAKE_DLLTOOL}" -m i386 -d "${def}" -l "${lib}" RESULT_VARIABLE result)
      if(NOT result EQUAL 0)
        message(FATAL_ERROR "Unable to build native SEH dispatcher import")
      endif()
      add_library(l4p_seh_dispatch STATIC IMPORTED GLOBAL)
      set_target_properties(l4p_seh_dispatch PROPERTIES IMPORTED_LOCATION "${lib}")
    endif()
    target_link_libraries(${target} PRIVATE l4p_seh_dispatch)
  endif()
endfunction()
