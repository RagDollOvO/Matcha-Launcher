cmake_minimum_required(VERSION 3.22)
project(beacon_source LANGUAGES CXX)
if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 4)
  message(FATAL_ERROR "Windows x86 toolchain required")
endif()
add_library(plugin SHARED plugin.cpp)
include(minhook/build.cmake)
target_link_libraries(plugin PRIVATE beacon_minhook)
include(native_seh.cmake)
l4p_native_seh(plugin "${CMAKE_CURRENT_SOURCE_DIR}/native_seh.c")
target_compile_features(plugin PRIVATE cxx_std_17)
target_compile_definitions(plugin PRIVATE UNICODE _UNICODE WINVER=0x0602 _WIN32_WINNT=0x0602)
target_include_directories(plugin PRIVATE .)
if(MSVC)
  target_compile_options(plugin PRIVATE /utf-8)
endif()
if(MINGW)
  target_link_options(plugin PRIVATE -static)
endif()
set_target_properties(plugin PROPERTIES PREFIX "")
