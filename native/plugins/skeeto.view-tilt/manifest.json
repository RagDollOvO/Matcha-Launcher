      "version": "0.4.0"
    }
  ],
  "config": [
    {
      "id": "active",
      "label": "功能总开关",
      "type": "boolean",
      "default": true,
      "apply": "immediate"
    },
    {
      "id": "angle",
      "label": "倾斜角度（度）",
      "type": "integer",
      "default": 4,
      "minimum": 0,
      "maximum": 12,
      "apply": "immediate"
    },
    {
      "id": "speed",
      "label": "侧移速度阈值",
      "type": "integer",
      "default": 200,
      "minimum": 0,
      "maximum": 500,
      "apply": "immediate"
    }
  ],
  "actions": [
    {
      "id": "status",
      "label": "读取功能状态",
      "effect": "read",
      "requiresConfirmation": false,
      "parameters": {},
      "description": "显示每项参数的应用、等待、缺失或冲突状态。"
    },
    {
      "id": "configure",
      "label": "保存功能设置",
      "effect": "write",
      "requiresConfirmation": true,
      "parameters": {
        "active": {
          "type": "boolean",
          "default": true
        },
        "angle": {
          "type": "integer",
          "default": 4,
          "minimum": 0,
          "maximum": 12
        },
        "speed": {
          "type": "integer",
          "default": 200,
          "minimum": 0,
          "maximum": 500
        }
      },
      "description": "保存独立设置；下一游戏帧应用，关闭选项后恢复所持有的原值。"
    }
  ],
  "presentation": {
    "schema": 1,
    "summary": "侧移时产生轻微的视角倾斜，独立调整角度与速度阈值。",
    "description": "移植 Black Mesa View Tilt 的两个视觉参数：倾斜角度 0–12 度，侧移阈值 0–500。角度为 0 时释放倾斜参数。沿用客户端本地视觉参数，关闭后恢复。\n\n每个选项关闭后，SDK 恢复启用前的游戏参数。游戏内切服会重新检查适用环境，冲突与缺失参数可在功能状态里查看。配置存入本 DLL 的 config.json。实际游戏效果待实测。",
    "tags": [
      "源码移植",
      "待游戏实测"
    ],
    "catalog": {
      "id": "skeeto",
      "title": "Skeeto",
