        "flashlight": {
          "type": "boolean",
          "default": false
        },
        "look": {
          "type": "boolean",
          "default": false
        },
        "weapon": {
          "type": "boolean",
          "default": false
        },
        "person": {
          "type": "boolean",
          "default": false
        },
        "bot-names": {
          "type": "boolean",
          "default": false
        },
        "name-nick": {
          "type": "string",
          "maxLength": 23,
          "default": ""
        },
        "name-rochelle": {
          "type": "string",
          "maxLength": 23,
          "default": ""
        },
        "name-coach": {
          "type": "string",
          "maxLength": 23,
          "default": ""
        },
        "name-ellis": {
          "type": "string",
          "maxLength": 23,
          "default": ""
        },
        "name-bill": {
          "type": "string",
          "maxLength": 23,
          "default": ""
        },
