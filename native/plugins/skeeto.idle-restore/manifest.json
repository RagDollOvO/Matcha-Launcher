  "apiVersion": 1,
  "architecture": "x86",
  "phase": "render-init",
  "entry": "plugin.dll",
  "developer": {
    "author": "Flare · Skeeto 源码接入",
    "purpose": "闲置接管后恢复自己的手电、朝向、武器槽与人称，编辑八角色 BOT 的本地显示名",
    "license": "GPL-3.0",
    "source": {
      "visibility": "private",
      "url": null,
      "commit": null
    },
    "modes": [
      "untested"
    ],
    "gameBuilds": [
      "untested"
    ],
    "capabilities": {
      "filesystem": [
        "保存本模块 config.json"
      ],
      "network": [],
      "externalPrograms": [],
      "hooks": [
        "Source 游戏帧、闲置事件、实体、原生玩家操作、声音过滤与 VGUI 本地化 SDK"
      ],
      "memoryModification": [
        "受限手电亮度压暗仅在本地服生效，释放租约时恢复原值",
        "按归属恢复本地玩家视角与人称；BOT 显示名通过本地化读取覆盖，原生表保持"
      ]
    },
