{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matcha",
  "mainBinaryName": "Matcha",
  "version": "1.0.1",
  "identifier": "com.matcha.launcher",
  "build": {
    "beforeDevCommand": "node scripts/ensure-vite.mjs",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -- --mode desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Matcha",
        "visible": false,
        "width": 1360,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 700,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/media/home-relax.mp3"
        ]
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://asset.localhost asset: https://*.hdslb.com https://www.gamemaps.com; font-src 'self'; media-src 'self' blob: http://asset.localhost asset:; connect-src 'self' ipc: http://ipc.localhost http://asset.localhost asset: http://localhost:5173 ws://localhost:5173"
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.ico"
    ],
    "active": false,
    "resources": {
      "../media/home-relax.mp3": "media/home-relax.mp3",
      "../backend/core.mjs": "backend/core.mjs",
      "../backend/steam-profile.mjs": "backend/steam-profile.mjs",
      "../backend/releases.mjs": "backend/releases.mjs",
      "../backend/launch.mjs": "backend/launch.mjs",
      "../backend/launch-argv.mjs": "backend/launch-argv.mjs",
      "../backend/clean-launch.mjs": "backend/clean-launch.mjs",
      "../backend/native-libraries.mjs": "backend/native-libraries.mjs",
      "../backend/l4n-plugins.mjs": "backend/l4n-plugins.mjs",
      "../backend/dll-status.mjs": "backend/dll-status.mjs",
      "../backend/dll-intake.mjs": "backend/dll-intake.mjs",
      "../backend/dll-sources.mjs": "backend/dll-sources.mjs",
      "../backend/plugin-overlays.mjs": "backend/plugin-overlays.mjs",
      "../backend/plugin-assets.mjs": "backend/plugin-assets.mjs",
      "../backend/saved-game-settings.mjs": "backend/saved-game-settings.mjs",
      "../backend/game-config.mjs": "backend/game-config.mjs",
      "../backend/cfg-text.mjs": "backend/cfg-text.mjs",
      "../backend/pi/settings-host.mjs": "backend/pi/settings-host.mjs",
      "../backend/pi/settings-tools.mjs": "backend/pi/settings-tools.mjs",
      "../backend/game-settings.mjs": "backend/game-settings.mjs",
